{
  "name": "@hildegard/server",
  "version": "0.1.17",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./version": "./src/version.ts",
    "./config": "./src/config.ts",
    "./secrets": "./src/hf.ts",
    "./lifecycle": "./src/lifecycle.ts",
    "./update": "./src/update.ts",
    "./constants": "./src/constants.ts",
    "./host": "./src/host.ts",
    "./compile-cache": "./src/compile-cache.ts"
  },
  "bin": {
    "hildegard-server": "./src/main.ts"
  },
  "scripts": {
    "dev": "node --watch src/main.ts --fake-gpu --port 7361 --data ../../.dev-data",
    "start": "node src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hildegard/comfy": "workspace:*",
    "@hildegard/craft": "workspace:*",
    "@hildegard/mcp": "workspace:*",
    "@hildegard/presets": "workspace:*",
    "@hildegard/runtime": "workspace:*",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/keyring": "2.1.2",
    "hono": "4.13.13",
    "zod": "4.6.7"
  }
}
