#!/bin/bash
# SPDX-License-Identifier: AGPL-3.0-only
# omarchy:summary=Set up Hildegard: install it for this user, pick a model, link AI apps
# omarchy:hidden=true
#
# Runs in a terminal the bar widget opens. Installs Hildegard for this user only (no root, nothing outside your home
# folder) from the release pinned in ../release.env, refusing an installer whose SHA-256 doesn't match, then runs
# `hildegard setup`, which asks you before accepting any model license or linking any app.
set -euo pipefail
umask 077

HERE=$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/hildegard-omarchy
mkdir -p "$STATE"
exec 9>"$STATE/setup.lock"
flock -n 9 || {
  echo "Hildegard setup is already open."
  exit 1
}
trap 'rc=$?; if [[ -t 0 ]]; then echo; read -rp "Press Enter to close. " _; fi; exit $rc' EXIT

# shellcheck source=../release.env
. "$HERE/../release.env"
BIN=${XDG_BIN_HOME:-$HOME/.local/bin}

if command -v hildegard >/dev/null 2>&1 || [[ -x $BIN/hildegard ]]; then
  echo "Hildegard is installed."
else
  if [[ -z $HILDEGARD_VERSION || -z $INSTALL_SH_SHA256 ]]; then
    echo "This version of the plugin doesn't name a Hildegard release yet."
    echo "Install Hildegard from https://github.com/baney75/hildegard, then run Set up again."
    exit 1
  fi
  echo "Installing Hildegard $HILDEGARD_VERSION for you alone: no root, nothing outside your home folder."
  dl=$(mktemp -d)
  trap 'rc=$?; rm -rf "$dl"; if [[ -t 0 ]]; then echo; read -rp "Press Enter to close. " _; fi; exit $rc' EXIT
  # HILDEGARD_RELEASE_URL (also read by install.sh) points at a mirror of the release, for testing.
  export HILDEGARD_RELEASE_URL=${HILDEGARD_RELEASE_URL:-https://github.com/baney75/hildegard/releases/download/v$HILDEGARD_VERSION}
  curl -fsSL --retry 3 -o "$dl/install.sh" "$HILDEGARD_RELEASE_URL/install.sh"
  got=$(sha256sum "$dl/install.sh" | cut -d' ' -f1)
  if [[ $got != "$INSTALL_SH_SHA256" ]]; then
    echo "The installer didn't match its checksum (expected $INSTALL_SH_SHA256, got $got). Nothing was installed."
    exit 1
  fi
  # Verified above. It checks Node.js and Hildegard against hashes written into it the same way.
  HILDEGARD_SKIP_SETUP=1 bash "$dl/install.sh"
  "$BIN/hildegard" install
fi

hildegard_bin=$(command -v hildegard || echo "$BIN/hildegard")
"$hildegard_bin" setup
echo
"$hildegard_bin" hf status
echo
echo "Done. Hildegard is in your bar; click it to see renders, or open the Studio."
