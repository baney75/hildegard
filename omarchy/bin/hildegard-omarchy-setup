#!/bin/bash
# SPDX-License-Identifier: AGPL-3.0-only
# omarchy:summary=Set up Hildegard: install it for this user, pick a model, link AI apps
# omarchy:hidden=true
#
# Runs in a terminal the bar widget opens. Installs Hildegard for this user only (no root, nothing outside your home
# folder) with the installer that ships inside this plugin, share/install.sh, refusing it unless it matches the
# SHA-256 pinned in ../release.env. No script is downloaded and run: the installer is part of the plugin you added, and
# it checks Node.js and Hildegard against SHA-256s written into it. Then it runs `hildegard setup`, which asks you
# before accepting any model license or linking any app.
#
# For agents and scripts: `hildegard-omarchy-setup --yes --json` asks nothing. It links the AI apps it finds, accepts no
# license, and its last line is `hildegard setup`'s JSON (see INSTALL-FOR-AGENTS.md in the Hildegard repo).
set -euo pipefail
umask 077

HERE=$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
PLUGIN=$(dirname -- "$HERE")
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/hildegard-omarchy
mkdir -p "$STATE"
exec 9>"$STATE/setup.lock"
flock -n 9 || {
  say "Hildegard setup is already open."
  exit 1
}
agent=()
for arg in "$@"; do
  case $arg in
  --yes | --json) agent+=("$arg") ;;
  *)
    echo "usage: hildegard-omarchy-setup [--yes] [--json]" >&2
    exit 2
    ;;
  esac
done
# Say things on stderr, so that with --json the only thing on stdout is JSON.
say() { printf '%s\n' "$*" >&2; }
pause() { if [[ ${#agent[@]} -eq 0 && -t 0 ]]; then echo; read -rp "Press Enter to close. " _; fi; }
trap 'rc=$?; pause; exit $rc' EXIT

# shellcheck source=../release.env
. "$PLUGIN/release.env"
BIN=${XDG_BIN_HOME:-$HOME/.local/bin}
INSTALLER=$PLUGIN/share/install.sh

if command -v hildegard >/dev/null 2>&1 || [[ -x $BIN/hildegard ]]; then
  say "Hildegard is installed."
else
  if [[ -z $HILDEGARD_VERSION || -z $INSTALL_SH_SHA256 || ! -f $INSTALLER ]]; then
    # A copy of the omarchy folder from a Hildegard checkout: its installer is built with each release.
    say "This copy of the plugin carries no Hildegard installer. Add the plugin with"
    say "  omarchy plugin add https://github.com/baney75/omarchy-hildegard --enable"
    say "or install Hildegard from https://github.com/baney75/hildegard#install, then run Set up again."
    exit 1
  fi
  got=$(sha256sum "$INSTALLER" | cut -d' ' -f1)
  if [[ $got != "$INSTALL_SH_SHA256" ]]; then
    say "The plugin's installer didn't match its checksum (expected $INSTALL_SH_SHA256, got $got). Nothing was installed."
    say "Update the plugin with: omarchy plugin update io.github.baney75.hildegard"
    exit 1
  fi
  say "Installing Hildegard $HILDEGARD_VERSION for you alone: no root, nothing outside your home folder."
  HILDEGARD_SKIP_SETUP=1 sh "$INSTALLER" >&2
  "$BIN/hildegard" install "${agent[@]}" >&2
fi

hildegard_bin=$(command -v hildegard || echo "$BIN/hildegard")
if [[ ${#agent[@]} -gt 0 ]]; then
  exec "$hildegard_bin" setup "${agent[@]}"
fi
"$hildegard_bin" setup
echo
"$hildegard_bin" hf status
echo
echo "Done. Hildegard is in your bar; click it to see renders, or open the Studio."
