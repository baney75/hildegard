# The Hildegard release that "Set up" installs, and the SHA-256 of its installer, share/install.sh, which ships in the
# plugin. Setup refuses an installer that doesn't match. scripts/build-release.mjs fills both, and adds the installer,
# when it builds the plugin for baney75/omarchy-hildegard; a checkout of the Hildegard repo leaves them empty.
HILDEGARD_VERSION=
INSTALL_SH_SHA256=
